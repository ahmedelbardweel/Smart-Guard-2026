<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Base.Theme.MyApplication" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/cyan</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/cyan_soft</item>
        <item name="colorOnPrimaryContainer">@color/cyan</item>
        <item name="colorSecondary">@color/mint</item>
        <item name="colorSecondaryContainer">@color/cyan_soft</item>
        <item name="colorOnSecondaryContainer">@color/cyan</item>
        <item name="colorSurface">@color/surface</item>
        <item name="android:colorBackground">@color/white</item>
        <item name="android:statusBarColor">@color/white</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">@color/white</item>
        <item name="android:windowLightStatusBar">false</item>

        <item name="android:fontFamily">@font/app_font</item>
        <item name="android:windowAnimationStyle">@style/WindowAnim</item>
        <item name="materialButtonStyle">@style/Widget.App.Button</item>
        <item name="colorControlActivated">@color/cyan</item>
    </style>

    <style name="Theme.MyApplication" parent="Base.Theme.MyApplication" />
    
    <style name="Theme.MyApplication.Green" parent="Base.Theme.MyApplication">
        <item name="colorPrimary">#388E3C</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorPrimaryContainer">#C8E6C9</item>
        <item name="colorOnPrimaryContainer">#1B5E20</item>
        <item name="colorSecondary">#81C784</item>
        <item name="colorSecondaryContainer">#C8E6C9</item>
        <item name="colorOnSecondaryContainer">#1B5E20</item>
    </style>

    <style name="Theme.MyApplication.Blue" parent="Base.Theme.MyApplication">
        <item name="colorPrimary">#1976D2</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorPrimaryContainer">#BBDEFB</item>
        <item name="colorOnPrimaryContainer">#0D47A1</item>
        <item name="colorSecondary">#64B5F6</item>
        <item name="colorSecondaryContainer">#BBDEFB</item>
        <item name="colorOnSecondaryContainer">#0D47A1</item>
    </style>

    <style name="Theme.MyApplication.Purple" parent="Base.Theme.MyApplication">
        <item name="colorPrimary">#7B1FA2</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorPrimaryContainer">#E1BEE7</item>
        <item name="colorOnPrimaryContainer">#4A148C</item>
        <item name="colorSecondary">#BA68C8</item>
        <item name="colorSecondaryContainer">#E1BEE7</item>
        <item name="colorOnSecondaryContainer">#4A148C</item>
    </style>

    <style name="Theme.MyApplication.Amber" parent="Base.Theme.MyApplication">
        <item name="colorPrimary">#FFA000</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorPrimaryContainer">#FFECB3</item>
        <item name="colorOnPrimaryContainer">#FF6F00</item>
        <item name="colorSecondary">#FFD54F</item>
        <item name="colorSecondaryContainer">#FFECB3</item>
        <item name="colorOnSecondaryContainer">#FF6F00</item>
    </style>

    <style name="Theme.MyApplication.Rose" parent="Base.Theme.MyApplication">
        <item name="colorPrimary">#D32F2F</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorPrimaryContainer">#FFCDD2</item>
        <item name="colorOnPrimaryContainer">#B71C1C</item>
        <item name="colorSecondary">#E57373</item>
        <item name="colorSecondaryContainer">#FFCDD2</item>
        <item name="colorOnSecondaryContainer">#B71C1C</item>
    </style>

    <style name="WindowAnim" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/activity_enter</item>
        <item name="android:activityOpenExitAnimation">@anim/activity_exit</item>
        <item name="android:activityCloseEnterAnimation">@anim/activity_pop_enter</item>
        <item name="android:activityCloseExitAnimation">@anim/activity_pop_exit</item>
    </style>

    <style name="Widget.App.Button" parent="Widget.Material3.Button">
        <item name="shapeAppearance">@style/ShapeAppearance.App.Button</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minHeight">45dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="elevation">0dp</item>
        <item name="backgroundTint">?attr/colorPrimary</item>
        <item name="android:textColor">?attr/colorOnPrimary</item>
        <item name="android:fontFamily">@font/app_font</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAppearance">@style/TextAppearance.App.ButtonText</item>
    </style>

    <!-- Typography System -->
    <style name="TextAppearance.App.ButtonText" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">@font/app_font</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="TextAppearance.App.HeadlineMedium" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:textSize">28sp</item>
        <item name="android:fontFamily">@font/app_font</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">?android:textColorPrimary</item>
    </style>

    <style name="TextAppearance.App.HeadlineSmall" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:textSize">24sp</item>
        <item name="android:fontFamily">@font/app_font</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">?android:textColorPrimary</item>
    </style>

    <style name="TextAppearance.App.TitleLarge" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textSize">22sp</item>
        <item name="android:fontFamily">@font/app_font</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">?android:textColorPrimary</item>
    </style>

    <style name="TextAppearance.App.TitleMedium" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">@font/app_font</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">?android:textColorPrimary</item>
    </style>

    <style name="TextAppearance.App.BodyLarge" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">@font/app_font</item>
        <item name="android:textColor">?android:textColorPrimary</item>
    </style>

    <style name="TextAppearance.App.BodyMedium" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">@font/app_font</item>
        <item name="android:textColor">?android:textColorSecondary</item>
    </style>

    <style name="TextAppearance.App.LabelLarge" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">@font/app_font</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Shape System -->
    <style name="ShapeAppearance.App.Small" parent="ShapeAppearance.Material3.SmallComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/radius_sm</item>
    </style>
    
    <style name="ShapeAppearance.App.Medium" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/radius_md</item>
    </style>

    <style name="ShapeAppearance.App.Large" parent="ShapeAppearance.Material3.LargeComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/radius_lg</item>
    </style>

    <style name="ShapeAppearance.App.ExtraLarge" parent="ShapeAppearance.Material3.Corner.ExtraLarge">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/radius_xl</item>
    </style>

    <style name="ShapeAppearance.App.Pill" parent="ShapeAppearance.Material3.Corner.Full">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <style name="ShapeAppearance.App.Button" parent="ShapeAppearance.Material3.Corner.Medium">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/button_radius</item>
    </style>
</resources>
